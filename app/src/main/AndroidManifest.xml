<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Privacy guarantee: the app must never talk to the network.
         tools:node="remove" strips INTERNET even if a library manifest requests it. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- 8d: live IPS-QR scanning. Camera is a device capability, not network. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
        Auto Backup is OFF, and with private storage that is not a preference but
        a requirement. Since v1.7 the archive lives in `filesDir`, which Android's
        automatic backup uploads to the user's Google Drive by default — together
        with the database and the address book. An app that declares itself fully
        on-device, and that strips INTERNET from its own manifest, must not have
        its users' bills leave the phone through a system service either.

        It also explains a surprise on the device: after an uninstall/reinstall
        the address book and the chosen language came back. That was the restore,
        not persistence.

        Getting data off the phone is export's job — deliberate, visible, and
        aimed at a folder the user picked.
    -->
    <application
        android:name=".RacunkoApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Racunko">

        <!--
            One instance, one entry in Recents — including when a banking app
            shares a confirmation into Računko.

            Do NOT declare android:taskAffinity here. An empty affinity means the
            activity belongs to no named task, so singleTask has no task to find
            and reuse and every share builds a fresh one. That was one half of the
            "second Računko in Recents" bug; the default affinity (the package
            name) is what lets singleTask bring the existing task forward.

            The other half is that a *sender* can still defeat that lookup, so
            nothing outside the app is allowed to start this activity any more:
            the share filters live on ShareTargetActivity below, which relaunches
            this window from our own process. documentLaunchMode="never" stays as
            a third line of defence against FLAG_ACTIVITY_NEW_DOCUMENT /
            MULTIPLE_TASK.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:documentLaunchMode="never"
            android:excludeFromRecents="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Share target: payment confirmations (PDF from banking apps, or
            screenshots). Invisible trampoline — see ShareTargetActivity for why
            it exists. taskAffinity="" is correct HERE and only here: it keeps the
            trampoline out of the real Računko task. excludeFromRecents + noHistory
            keep it out of Recents and out of the back stack.
        -->
        <activity
            android:name=".ShareTargetActivity"
            android:exported="true"
            android:theme="@style/Theme.RacunkoInvisible"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:documentLaunchMode="never">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Fallback for sharing when a SAF document uri cannot be re-granted to the target app -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Persist the in-app language choice (per-app locales backport) -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
